---
permalink: /api/index.json
layout: null
---
{
  "posts_url": {{ "/api/posts.json" | relative_url | jsonify }},
  "season_list": {{ site.data.season_list | where: "available", true | jsonify }},
  "seasons": {
    {% assign first = true %}
    {% for s in site.data.season_list %}
      {% if s.available %}
        {% unless first %},{% endunless %}
        {{ s.id | jsonify }}: {{ site.data.seasons[s.id] | jsonify }}
        {% assign first = false %}
      {% endif %}
    {% endfor %}
  }
}